{
  "rules": {
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'MODERATOR_UID'"
    },

    "questions": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'MODERATOR_UID'",
      "$qid": {
        ".write": "auth != null && !data.exists() && newData.exists() && root.child('config/event/open').val() === true && newData.parent().parent().child('authors').child($qid).val() === auth.uid && newData.parent().parent().child('lastPost').child(auth.uid).val() === now",
        ".validate": "newData.hasChildren(['text', 'target', 'createdAt'])",
        "text": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 300" },
        "target": { ".validate": "newData.isString() && (newData.val() === 'all' || root.child('config/targets').child(newData.val()).exists() || auth.uid === 'MODERATOR_UID')" },
        "createdAt": { ".validate": "newData.isNumber() && (newData.val() === now || auth.uid === 'MODERATOR_UID')" },
        "asked": { ".validate": "newData.isBoolean() && auth.uid === 'MODERATOR_UID'" },
        "askedAt": { ".validate": "newData.isNumber() && auth.uid === 'MODERATOR_UID'" },
        "$other": { ".validate": false }
      }
    },

    "authors": {
      ".read": "auth != null && auth.uid === 'MODERATOR_UID'",
      ".write": "auth != null && auth.uid === 'MODERATOR_UID'",
      "$qid": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },

    "lastPost": {
      ".write": "auth != null && auth.uid === 'MODERATOR_UID'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || data.val() < now - 20000)"
      }
    },

    "votes": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'MODERATOR_UID'",
      "$qid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('questions').child($qid).exists() && root.child('questions').child($qid).child('asked').val() !== true && root.child('authors').child($qid).val() !== auth.uid))",
          ".validate": "newData.val() === true"
        }
      }
    },

    "hidden": {
      ".read": "auth != null && auth.uid === 'MODERATOR_UID'",
      ".write": "auth != null && auth.uid === 'MODERATOR_UID'"
    },

    "queue": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'MODERATOR_UID'"
    },

    "projection": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'MODERATOR_UID'"
    }
  }
}
